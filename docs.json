      { "group": "Protocol", "pages": ["docs/protocol/economic-model", "docs/protocol/bonding-curve", "docs/protocol/fees-and-distribution", "docs/protocol/graduation", "docs/protocol/uniswap-v3-market", "docs/protocol/permanent-liquidity-custody", "docs/protocol/voluntary-cto", "docs/protocol/trader-rewards"] },
      { "group": "Using Cooket", "pages": ["docs/using-cooket/connect-wallet", "docs/using-cooket/create-token", "docs/using-cooket/buy-tokens", "docs/using-cooket/sell-tokens", "docs/using-cooket/discover-tokens", "docs/using-cooket/token-pages", "docs/using-cooket/trading-terminal", "docs/using-cooket/transaction-lifecycle"] },
      { "group": "Developers", "pages": ["docs/developers/system-architecture", "docs/developers/frontend", "docs/developers/api", "docs/developers/indexer", "docs/developers/realtime-market-service", "docs/developers/database", "docs/developers/contract-sdk", "docs/developers/local-development", "docs/developers/environment-configuration"] },
      { "group": "API Reference", "pages": ["docs/api-reference/overview", "docs/api-reference/tokens", "docs/api-reference/trades", "docs/api-reference/discovery", "docs/api-reference/metadata", "docs/api-reference/cto", "docs/api-reference/realtime-sse", "docs/api-reference/errors"] },
