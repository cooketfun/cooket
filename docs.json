      { "group": "Reference", "pages": ["docs/reference/arc-testnet-contracts", "docs/reference/network-configuration", "docs/reference/economic-constants", "docs/reference/glossary", "docs/reference/faq", "docs/reference/troubleshooting"] }
    ]
  },
  "footer": { "socials": { "github": "https://github.com/cooketfun/cooket" } },
  "seo": {
    "indexing": "navigable",
    "organization": { "name": "Cooket", "url": "https://cooket.fun", "logo": "https://cooket.fun/brand/cooket-icon.png", "sameAs": ["https://github.com/cooketfun/cooket"] }
