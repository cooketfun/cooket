# Cooket Arc Testnet local-development template.
# Copy locally only when needed. Never commit a real .env or any secret.

APP_ENV=development
COOKET_CHAIN_ID=5042002

API_HOST=0.0.0.0
API_PORT=4000
COOKET_CORS_ORIGINS=http://localhost:3200,http://127.0.0.1:3200

POSTGRES_DB=cooket_arc
POSTGRES_USER=cooket_arc
POSTGRES_PASSWORD=replace_with_local_secret
DATABASE_URL=postgresql://cooket_arc:${POSTGRES_PASSWORD}@postgres:5432/cooket_arc?sslmode=disable
REDIS_URL=redis://redis:6379/0

NEXT_PUBLIC_API_URL=http://localhost:4200
INTERNAL_API_URL=http://api:4000
NEXT_PUBLIC_REOWN_PROJECT_ID=
NEXT_PUBLIC_APP_NAME=Cooket
NEXT_PUBLIC_APP_URL=http://localhost:3200

# Arc Testnet only. The public official RPC is the safe default. A private
# server-side endpoint may be supplied locally, but credentials must never be
# copied into NEXT_PUBLIC_*.
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.io
NEXT_PUBLIC_ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.io
NEXT_PUBLIC_COOKET_CHAIN_ID=5042002

# No Cooket contracts have been approved or deployed for Arc Testnet in Phase 0.
# Keep every address blank. Never copy Base addresses into these fields.
COOKET_FACTORY_V3_ADDRESS=
COOKET_INDEXER_CONTRACTS=
NEXT_PUBLIC_COOKET_FACTORY_V3_ADDRESS=
NEXT_PUBLIC_FEE_MANAGER_V3_ADDRESS=
NEXT_PUBLIC_GRADUATION_MANAGER_V3_ADDRESS=
NEXT_PUBLIC_PERMANENT_LP_FEE_VAULT_V3_ADDRESS=
NEXT_PUBLIC_PERMANENT_LP_CUSTODIAN_DEPLOYER_V3_ADDRESS=
NEXT_PUBLIC_GRADUATION_SETTLEMENT_EXECUTOR_V3_ADDRESS=

INDEXER_MODE=idle
INDEXER_START_BLOCK=
INDEXER_STOP_BLOCK=
INDEXER_CONFIRMATIONS=6
INDEXER_BATCH_SIZE=500
INDEXER_RPC_MAX_ATTEMPTS=3
INDEXER_RPC_INITIAL_DELAY_MS=100
INDEXER_RPC_MAX_DELAY_MS=2000

# Phase 0 intentionally has no Arc DEX, wrapped-native, oracle, deployment,
# governance, treasury, signer, or private-key configuration.
