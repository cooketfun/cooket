FROM node:22-alpine

ARG NEXT_PUBLIC_API_URL=http://localhost:4200
ARG NEXT_PUBLIC_REOWN_PROJECT_ID
ARG NEXT_PUBLIC_APP_NAME=Arc Testnet Launchpad
ARG NEXT_PUBLIC_APP_URL=http://localhost:3200
ARG NEXT_PUBLIC_COOKET_CHAIN_ID=5042002
ARG NEXT_PUBLIC_ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.io
ARG NEXT_PUBLIC_COOKET_FACTORY_V3_ADDRESS
ARG NEXT_PUBLIC_FEE_MANAGER_V3_ADDRESS
ARG NEXT_PUBLIC_GRADUATION_MANAGER_V3_ADDRESS
ARG NEXT_PUBLIC_PERMANENT_LP_FEE_VAULT_V3_ADDRESS
ARG NEXT_PUBLIC_PERMANENT_LP_CUSTODIAN_DEPLOYER_V3_ADDRESS
ARG NEXT_PUBLIC_GRADUATION_SETTLEMENT_EXECUTOR_V3_ADDRESS
ARG NEXT_PUBLIC_ARC_TESTNET_UNISWAP_V3_SWAP_ROUTER
ARG NEXT_PUBLIC_ARC_TESTNET_UNISWAP_V3_QUOTER_V2
ARG NEXT_PUBLIC_ARC_TESTNET_UNISWAP_V3_FACTORY
ARG NEXT_PUBLIC_ARC_TESTNET_CANONICAL_USDC
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_REOWN_PROJECT_ID=$NEXT_PUBLIC_REOWN_PROJECT_ID
ENV NEXT_PUBLIC_APP_NAME=$NEXT_PUBLIC_APP_NAME
ENV NEXT_PUBLIC_APP_URL=$NEXT_PUBLIC_APP_URL
ENV NEXT_PUBLIC_COOKET_CHAIN_ID=$NEXT_PUBLIC_COOKET_CHAIN_ID
ENV NEXT_PUBLIC_ARC_TESTNET_RPC_URL=$NEXT_PUBLIC_ARC_TESTNET_RPC_URL
ENV NEXT_PUBLIC_COOKET_FACTORY_V3_ADDRESS=$NEXT_PUBLIC_COOKET_FACTORY_V3_ADDRESS
ENV NEXT_PUBLIC_FEE_MANAGER_V3_ADDRESS=$NEXT_PUBLIC_FEE_MANAGER_V3_ADDRESS
ENV NEXT_PUBLIC_GRADUATION_MANAGER_V3_ADDRESS=$NEXT_PUBLIC_GRADUATION_MANAGER_V3_ADDRESS
ENV NEXT_PUBLIC_PERMANENT_LP_FEE_VAULT_V3_ADDRESS=$NEXT_PUBLIC_PERMANENT_LP_FEE_VAULT_V3_ADDRESS
ENV NEXT_PUBLIC_PERMANENT_LP_CUSTODIAN_DEPLOYER_V3_ADDRESS=$NEXT_PUBLIC_PERMANENT_LP_CUSTODIAN_DEPLOYER_V3_ADDRESS
ENV NEXT_PUBLIC_GRADUATION_SETTLEMENT_EXECUTOR_V3_ADDRESS=$NEXT_PUBLIC_GRADUATION_SETTLEMENT_EXECUTOR_V3_ADDRESS
ENV NEXT_PUBLIC_ARC_TESTNET_UNISWAP_V3_SWAP_ROUTER=$NEXT_PUBLIC_ARC_TESTNET_UNISWAP_V3_SWAP_ROUTER
ENV NEXT_PUBLIC_ARC_TESTNET_UNISWAP_V3_QUOTER_V2=$NEXT_PUBLIC_ARC_TESTNET_UNISWAP_V3_QUOTER_V2
ENV NEXT_PUBLIC_ARC_TESTNET_UNISWAP_V3_FACTORY=$NEXT_PUBLIC_ARC_TESTNET_UNISWAP_V3_FACTORY
ENV NEXT_PUBLIC_ARC_TESTNET_CANONICAL_USDC=$NEXT_PUBLIC_ARC_TESTNET_CANONICAL_USDC

WORKDIR /app
RUN corepack enable && corepack prepare pnpm@10.33.0 --activate
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/web/package.json ./apps/web/package.json
COPY packages ./packages
RUN pnpm install --frozen-lockfile
COPY apps/web ./apps/web
RUN pnpm --filter web build

WORKDIR /app/apps/web
EXPOSE 3000
CMD ["pnpm", "start"]
